# Salin menjadi .env lalu ganti semua nilai "ganti_...". JANGAN commit file .env
# (atau jalankan scripts/setup-env.sh / scripts/setup-env.ps1 untuk membuatnya otomatis)

# Port akses aplikasi dari browser -> http://localhost:APP_PORT
APP_PORT=8080

# Database (MySQL)
DB_NAME=monexa_db
DB_USER=cloudwallet
DB_PASSWORD=ganti_password_db
DB_ROOT_PASSWORD=ganti_password_root

# Backend
JWT_SECRET=ganti_dengan_string_acak_panjang

# Object storage (RustFS, S3-compatible)
RUSTFS_ACCESS_KEY=cloudwalletadmin
RUSTFS_SECRET_KEY=ganti_secret_storage
S3_BUCKET=receipts
# Opsional: kunci versi image supaya build bisa direproduksi
# RUSTFS_IMAGE=rustfs/rustfs:latest
