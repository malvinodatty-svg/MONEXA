# RustFS Object Storage
RUSTFS_ACCESS_KEY=isi_access_key_sendiri
RUSTFS_SECRET_KEY=isi_secret_key_sendiri

# Backend S3 Configuration
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=isi_access_key_sendiri
S3_SECRET_KEY=isi_secret_key_sendiri
S3_BUCKET=cloudwallet-backups

# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=isi_password_database
DB_NAME=monexa_db
DB_PORT=3306

# Backup API Security
BACKUP_API_TOKEN=ganti_dengan_token_acak_yang_aman

# MySQL Dump (sesuaikan dengan lokasi mysqldump di komputer)
MYSQLDUMP_PATH=C:\xampp\mysql\bin\mysqldump.exe
